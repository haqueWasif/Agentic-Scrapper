# Copy this file to .env and replace only the values needed by your setup.

# Required for ZenRows requests.
ZENROWS_API_KEY=your_zenrows_api_key_here

# Required for all document evaluation (OpenRouter free auto-router).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional LangSmith observability. The scraper runs normally when disabled.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ashrae-intelligent-scraper
# Optional when one API key is associated with multiple workspaces.
LANGSMITH_WORKSPACE_ID=
